# Prisma CLI (build) resolves this relative to prisma/schema.prisma → data/app.db
DATABASE_URL="file:../data/app.db"
ADMIN_PASSWORD="Admin17"

# Optional. Must be a folder *inside* the app directory (Hostinger jails Prisma there).
# Leave empty on Hostinger — the app uses ./data/app.db automatically.
# DATA_DIR=
