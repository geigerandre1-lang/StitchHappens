# Prisma CLI (build) resolves this relative to prisma/schema.prisma → data/app.db
DATABASE_URL="file:../data/app.db"
ADMIN_PASSWORD="Admin17"

# Optional. On Hostinger Node.js apps the runtime looks next to the domain folder
# (…/domains/<site>/data/app.db) when cwd is …/hbuilds/versions/<id>/nodejs.
# Set this in hPanel if auto-detect is wrong, e.g.:
# DATA_DIR=/home/u431743567/domains/stitchhappens.turniertool.eu/data
DATA_DIR=
